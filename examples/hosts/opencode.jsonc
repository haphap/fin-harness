{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 10000,
      "catalog": 10000,
      "execution": 60000
    },
    "servers": {
      "fin-harness": {
        "type": "local",
        "command": [
          "/absolute/path/to/fin-harness/.venv/bin/fin-harness",
          "mcp",
          "--config",
          "/absolute/path/to/fin-harness/examples/config.json"
        ],
        "cwd": "/absolute/path/to/fin-harness",
        "codemode": false
      }
    }
  }
}
